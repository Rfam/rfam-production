// Settings for the weekly PDB mapping pipeline on a SLURM cluster.
// Keep this file free of a shebang and of `nextflow.enable.dsl`: Nextflow
// 25.10+ parses configs strictly and rejects both.
// Machine-specific overrides can go in a git-ignored local.config passed with
// `nextflow run ... -c pipelines/pdb/local.config`.

env.PYTHONPATH = "/nfs/production/agb/rfam/users/rfamprod/code/rfam-production"

params {
    rfamprod = "/nfs/production/agb/rfam/users/rfamprod/code/rfam-production"
    preview = "/nfs/ftp/public/databases/Rfam/.preview"
    search_dumps = "/nfs/production/agb/rfam/search_dumps"
    email = "pmadrigal@ebi.ac.uk"
    pdb_files = "/nfs/production/agb/rfam/pdb_files"
    pdb_scripts = "/nfs/production/agb/rfam/users/rfamprod/code/rfam-production/scripts/pdb_mapping"
    seed_repo = "git@github.com:Rfam/rfam-3d-seed-alignments.git"
}

process {
    executor = 'slurm'
    maxForks = 2000
    time = '8h'
    memory = '8G'

    withName: run_cmscan {
        memory = { 16.GB * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 125] ? 'retry' : 'terminate' }
        maxRetries = 2
    }
}

executor {
    name = 'slurm'
    queueSize = 10000
}

singularity {
    enabled = true
    cacheDir = "${params.rfamprod}/pipelines/pdb/singularity"
}
